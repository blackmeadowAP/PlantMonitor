# Скопируйте в .env и заполните. Файл .env не коммитить.

# --- Telegram ---
BOT_TOKEN=
# Адрес Bot API (по умолчанию облачный Telegram; можно указать свой Local Bot API Server)
TELEGRAM_API_URL=https://api.telegram.org
# ID закрытого канала-архива оригиналов фото (шаг 6), например -1001234567890
ARCHIVE_CHANNEL_ID=

# --- Общие ---
LOG_LEVEL=INFO
TZ_NAME=Europe/Minsk

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=agro
POSTGRES_PASSWORD=agro
POSTGRES_DB=agro
DATABASE_URL=postgresql+asyncpg://agro:agro@db:5432/agro
# Тестовая БД (сервис db_test в compose; локально — порт 5433)
TEST_DATABASE_URL=postgresql+asyncpg://agro:agro@db_test:5432/agro_test

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- S3 (локально MinIO, в пилоте Cloudflare R2) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agro
S3_REGION=us-east-1

# --- Фото ---
GEO_MAX_DISTANCE_M=50
PHOTO_MAX_SIDE_PX=1600
HEALTHY_PHOTO_RETENTION_DAYS=30

# --- Нейросеть: off | local | space ---
ML_MODE=off
ML_CONFIDENCE_THRESHOLD=0.6
HF_TOKEN=

# --- Языковая модель (по умолчанию локальная Ollama) ---
LLM_ENABLED=false
LLM_URL=http://ollama:11434/v1
LLM_MODEL=
